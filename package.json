{
  "name": "@bemedev/new-package-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo workspace root",
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/new-package"
  },
  "type": "module",
  "scripts": {
    "ci": "CIN=$(date +%s) && vp install  && vp run pretest && vp run lint && vp run test:only && vp run posttest && echo \"\n✅ CI takes $(($(date +%s) - CIN))s\n\"",
    "ci:admin": "FULL_CI=$(date +%s) && vp run rm && pnpm run up && vp run ci && echo \"\n✅ Full CI takes $(($(date +%s) - FULL_CI))s\n\"",
    "pnpm:devPreinstall": "node -e \"const fs=require('fs'); const pkg=JSON.parse(fs.readFileSync('./package.json')); const version=require('child_process').execSync('pnpm -v').toString().trim(); pkg.packageManager='pnpm@' + version; fs.writeFileSync('./package.json', JSON.stringify(pkg, null, 2) + '\\n');\"",
    "config": "vp i",
    "rimraf": "vp dlx rimraf -rf",
    "rinit": "vp run rm && vp run config",
    "fmt": "vp fmt",
    "test": "vp test",
    "pretest": "vp run -r pretest",
    "posttest": "vp run size",
    "web:dev": "pnpm --filter @bemedev/web dev",
    "web:build": "pnpm --filter @bemedev/web build",
    "desktop:dev": "pnpm --filter @bemedev/desktop tauri:dev",
    "desktop:build": "pnpm --filter @bemedev/desktop tauri:build",
    "rm": "vp run rimraf -- node_modules pnpm-lock.yaml && pnpm clean --lockfile",
    "up": "vp update --latest && vp run check-updates",
    "check-updates": "vp dlx npm-check-updates -w -u --dep peer,optional,prod",
    "prepare": "husky",
    "p-q": "pretty-quick"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.5.0",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "catalog:",
    "glob": "^14.0.3",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.4",
    "size-limit": "^14.3.0",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0"
}
