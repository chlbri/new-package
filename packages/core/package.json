  "scripts": {
    "pack": "vp pack",
    "pretest": "vp pack",
    "posttest": "vp run fmt && vp run p-q",
    "_ci": "vp run lint && vp run test",
    "ci": "CI_START=$(date +%s) && vp run _ci && vp run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "_lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint": "vp run fmt && vp run lint:fix",
    "p-q": "pretty-quick",
    "rm": "rimraf ./node_modules ./vp-lock.yaml",
    "rm:lib": "rimraf -- lib",
    "size": "size-limit",
    "test": "vp run test:coverage --no-coverage",
    "test:only": "vp run test:coverage --no-coverage",
    "test:coverage": "vp test run --passWithNoTests",
    "test:watch": "vp test"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.5.0",
    "@size-limit/file": "^14.3.0",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
