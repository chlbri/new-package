{
  "github-actions.workflows.pinned.workflows": [".github/workflows/ci.yml"],
  "oxc.enable": true,
  "search.followSymlinks": false,
  "search.useIgnoreFiles": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/.pnpm-store": true,
    "**/.git": true,
    "**/.coverage": true,
    "**/.tanstack": true,
    "**/dist": true,
    "**/build": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.pnpm-store/**": true,
    "**/.coverage/**": true
  }
}

