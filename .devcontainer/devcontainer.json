{
  "name": "Node.js Library",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  // 2 GB RAM for the container
  "runArgs": ["--memory=2g", "--memory-swap=2g", "--cpus=2"],
  "hostRequirements": {
    "memory": "2gb"
  },
  // pnpm via corepack (ships with Node 24) + install deps
  "postCreateCommand": "corepack prepare pnpm@latest --activate && pnpm install",
  // Forward vitest --ui port, also Ollama
  "forwardPorts": [51204, 11434],
  "portsAttributes": {
    "51204": {
      "label": "Vitest UI",
      "onAutoForward": "notify"
    },
    "11434": {
      "label": "Ollama",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development",
    // Give Node.js ~3.5 GB out of the 4 GB container limit
    "NODE_OPTIONS": "--max-old-space-size=3584",
    // pnpm store inside the container (no cross-device issues)
    "PNPM_HOME": "/home/node/.local/share/pnpm"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "[typescript]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "coverage-gutters.coverageFileNames": [".coverage/lcov.info"],
        "vitest.enable": true,
        "vitest.commandLine": "pnpm run test:only"
      },
      "extensions": [
        // TypeScript / JavaScript
        "ms-vscode.vscode-typescript-next",
        "ms-vscode.js-debug",
        // Lint & format
        "oxc.oxc-vscode",
        // Testing
        "vitest.explorer",
        // Coverage
        // cspell:disable-next-line
        "ryanluker.vscode-coverage-gutters",
        // Git
        "adam-bender.commit-message-editor",
        // GitHub
        "github.vscode-github-actions",
        "github.copilot",
        "github.copilot-chat"
      ]
    }
  }
}
