{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "New Package",
  "version": "0.0.1",
  "identifier": "com.bemedev.newpackage",
  "build": {
    "beforeDevCommand": "pnpm --filter @bemedev/web dev",
    "devUrl": "http://localhost:3000",

    "beforeBuildCommand": "pnpm --filter @bemedev/web build",
    "frontendDist": "../../solidjs/dist/client"
  },
  "app": { "windows": [{ "title": "New Package", "width": 1200, "height": 800 }] },
  "bundle": {
    "active": true,
    "targets": "all",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
