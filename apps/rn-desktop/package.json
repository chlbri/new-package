{
  "name": "@bemedev/rn-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Cross-platform desktop app built with React Native and Expo, managed by Vite+",
  "homepage": "https://github.com/shirakaba/expo-desktop/tree/main/templates/blank-typescript",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "macos": "bash scripts/run-macos.sh",
    "windows": "expo-desktop run windows",
    "prebuild": "expo-desktop prebuild",
    "autolink-windows": "react-native autolink-windows",
    "web": "expo start --web",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check"
  },
  "dependencies": {
    "expo": "58.0.26",
    "expo-desktop": "^1.0.7",
    "expo-desktop-modules-core": "~55.0.3",
    "expo-desktop-stubs": "~55.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-macos": "0.83.0",
    "react-native-windows": "0.85.2"
  },
  "devDependencies": {
    "@react-native-windows/find-dotnet-tools": "0.0.0-canary.3",
    "@types/react": "~19.2.17",
    "expo-desktop-metro-config": "~55.83.3",
    "expo-desktop-template-bare-minimum": "~55.83.15",
    "typescript": "~5.9.2",
    "vite-plus": "catalog:"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-windows"
      ]
    },
    "install": {
      "exclude": [
        "react",
        "react-native"
      ]
    }
  }
}
